{"_id":"ea4ec3d676832bc7","name":"Speakers","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"speakers","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion has built-in speakers. You can speak through those speakers, allowing your voice to be heard from the robot.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.ea4ec3d676832bc7"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"speakers","customizationGrade":"commercial","automation":"manual"}}}
