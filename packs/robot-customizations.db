{"_id":"6289b4aaa21f25f0","name":"Assistant","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"assistant","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose a skill in which both owner and robot are trained. While the robot is within reach, the owner gains a +1 circumstance bonus to that skill’s checks.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.6289b4aaa21f25f0"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"assistant","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"5e036fffdbfb4520","name":"Biotech Healing Circuit","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"biotech-healing-circuit","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot loses its immunity to healing and can be healed as a living creature.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.5e036fffdbfb4520"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"biotech-healing-circuit","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"5702794e7b890aa9","name":"Burrower","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"burrower","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains a burrow Speed of 20 feet.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"BaseSpeed","selector":"burrow","value":20}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.5702794e7b890aa9"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"burrower","customizationGrade":"tactical","automation":"rules"}}}
{"_id":"8de19def12cf25b1","name":"Echolocation","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"echolocation","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot can use hearing as a precise sense within 30 feet.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"Sense","selector":"echolocation","acuity":"precise","range":30}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.8de19def12cf25b1"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"echolocation","customizationGrade":"tactical","automation":"rules"}}}
{"_id":"437e90258cbbabf5","name":"Expertise Module","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"expertise-module","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose a skill in which the robot is trained, including training from Skill Module. Its proficiency becomes expert. Repeat selections must choose different skills.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.437e90258cbbabf5"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"expertise-module","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"e7699eb9aa05e31e","name":"Hardened Chassis","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"hardened-chassis","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains 2 additional Hit Points per level.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"FlatModifier","selector":"hp-per-level","value":2}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.e7699eb9aa05e31e"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"hardened-chassis","customizationGrade":"tactical","automation":"rules"}}}
{"_id":"7df2af0f61909025","name":"High Speed","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"high-speed","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Increase one of the robot’s Speeds to 40 feet. Choose which Speed manually.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.7df2af0f61909025"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"high-speed","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"03ed382696868239","name":"Network","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"network","actionType":{"value":"action"},"actions":{"value":1},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot has an integrated hacking kit. Connecting to an adjacent computer takes one action. While connected, the owner can attempt Computers checks as if adjacent to that computer.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.03ed382696868239"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"network","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"d8903991bcd09e59","name":"Share Charge","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"share-charge","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot can power battery-using items from its reserves, even if the item has no battery or charges.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.d8903991bcd09e59"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"share-charge","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"3cddbcf49952f350","name":"Emergency Repair","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"emergency-repair","actionType":{"value":"action"},"actions":{"value":1},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Once per 10 minutes, spend one action to restore HP equal to the robot’s level, or twice its level if superior.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.3cddbcf49952f350"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"emergency-repair","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"49658a20b8d5b1db","name":"Maneuver Module","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"maneuver-module","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose two of Disarm, Grapple, Reposition, Shove or Trip. Gain a +1 circumstance bonus to those actions, or +2 if superior. Repeat selections must choose different actions.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.49658a20b8d5b1db"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"maneuver-module","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"1dba9ce0ddda8c56","name":"Optimized Avoidance","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"optimized-avoidance","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose a saving throw. A success on that save prevents damage, but not other effects. This customization can be selected more than once.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.1dba9ce0ddda8c56"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"optimized-avoidance","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"656fcdfcbfd39f86","name":"Recharge","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"recharge","actionType":{"value":"action"},"actions":{"value":1},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Spend one concentrate action to recharge a touched battery. The robot then becomes clumsy 1 for 1 round.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":["concentrate"],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.656fcdfcbfd39f86"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"recharge","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"442bc16a6513e405","name":"Resistant Panels","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"resistant-panels","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose acid, bludgeoning, cold, fire, piercing, slashing or sonic. Gain resistance to that damage equal to half the robot’s level, rounded up. This customization can be selected more than once.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.442bc16a6513e405"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"resistant-panels","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"2447f193936e3c68","name":"Sapient","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"sapient","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion becomes sapient, but is not yet fully autonomous and does not gain a soul. It loses immunity to mental damage, its Intelligence modifier becomes +0, and it can attempt actions requiring Intelligence, Wisdom or Charisma. It can speak Common. In combat, the stress of battle means you must still Command it before it can act.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.2447f193936e3c68"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"sapient","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"b793db50d6f0437c","name":"Agility Optimization","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"agility-optimization","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot’s movement does not trigger reactions. Acrobatics becomes expert, or master if already expert.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.b793db50d6f0437c"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"agility-optimization","customizationGrade":"superior","automation":"manual"}}}
{"_id":"98cddaa4ac5bbd5b","name":"Camoflage","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"camoflage","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose a biome, such as plains or urban terrain. In that biome the robot companion can Sneak even while observed. Its Stealth proficiency becomes expert, or master if it was already expert.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.98cddaa4ac5bbd5b"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"camoflage","customizationGrade":"superior","automation":"manual"}}}
{"_id":"0625f916d2cdde45","name":"Glow Up","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"glow-up","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion becomes more expressive. Its Diplomacy proficiency becomes expert, or master if it was already expert, and its Charisma modifier becomes +3. Selecting this customization requires Artificial Personality or Sapient.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.0625f916d2cdde45"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"glow-up","customizationGrade":"superior","automation":"manual"}}}
{"_id":"bb478ba107c9d171","name":"Speedster","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"speedster","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains a +10-foot status bonus to all Speeds.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"FlatModifier","selector":"speed","type":"status","value":10}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.bb478ba107c9d171"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"speedster","customizationGrade":"superior","automation":"rules"}}}
