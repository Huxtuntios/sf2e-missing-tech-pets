{"_id":"73244eafcc76f082","name":"Aquatic Adaptation","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"aquatic-adaptation","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion gains a swim Speed of 20 feet. This customization adds that movement mode; it does not replace its other Speeds.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"BaseSpeed","selector":"swim","value":20}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.73244eafcc76f082"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"aquatic-adaptation","customizationGrade":"commercial","automation":"rules"}}}
{"_id":"b280797f59395ce8","name":"Armored Plates","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"armored-plates","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains a +1 item bonus to AC, or +2 if it is a superior robot companion. Use unarmored proficiency. Choose the appropriate bonus when adding this Item; update that choice if the companion advances.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ChoiceSet","flag":"armoredPlatesBonus","adjustName":false,"prompt":"SFMTP.CustomArmorPrompt","choices":[{"label":"SFMTP.CustomArmorNormal","value":1},{"label":"SFMTP.CustomArmorSuperior","value":2}]},{"key":"FlatModifier","selector":"ac","type":"item","value":"{item|flags.sf2e.rulesSelections.armoredPlatesBonus}","fromEquipment":false}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.b280797f59395ce8"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"armored-plates","customizationGrade":"commercial","automation":"rules"}}}
{"_id":"0131b13e97f3864c","name":"Artificial Personality","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"artificial-personality","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion gains an artificial personality. It can attempt skill checks that require Charisma and can speak Common.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.0131b13e97f3864c"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"artificial-personality","customizationGrade":"commercial","automation":"manual"}}}
{"_id":"5643c994f42b46e1","name":"Cameras","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"cameras","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Cameras built into the robot companion transmit its view to the owner. Using a comm unit or a similar device, you can see what the robot sees.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.5643c994f42b46e1"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"cameras","customizationGrade":"commercial","automation":"manual"}}}
{"_id":"d3c973c2e9ff03c6","name":"Climber","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"climber","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains a climb Speed of 20 feet.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"BaseSpeed","selector":"climb","value":20}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.d3c973c2e9ff03c6"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"climber","customizationGrade":"commercial","automation":"rules"}}}
{"_id":"1703564ef0d8e887","name":"Flier","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"flier","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains a fly Speed of 20 feet.</p><p>@Localize[SFMTP.CustomRulesHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"BaseSpeed","selector":"fly","value":20}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.1703564ef0d8e887"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"flier","customizationGrade":"commercial","automation":"rules"}}}
{"_id":"69f3f651c5eb1e21","name":"Grounded","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"grounded","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Remove the robot’s weakness to electricity.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.69f3f651c5eb1e21"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"grounded","customizationGrade":"commercial","automation":"manual"}}}
{"_id":"c17c99ae5a060683","name":"Integrated Weapon Mount","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"integrated-weapon-mount","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Gain one weapon mount per selection. Installing or removing a weapon takes 10 minutes and has the manipulate trait. One-handed weapons require one mount; two-handed weapons require two. A mounted weapon is wielded and cannot be Disarmed. Interact to reload it requires no hands and loses the manipulate trait.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.c17c99ae5a060683"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"integrated-weapon-mount","customizationGrade":"commercial","automation":"manual"}}}
{"_id":"014028713a67b53a","name":"Light Mounts","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"light-mounts","actionType":{"value":"action"},"actions":{"value":1},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Shed bright light within 20 feet and dim light for 20 feet beyond that. Switch the light on or off with one action.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.014028713a67b53a"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"light-mounts","customizationGrade":"commercial","automation":"manual"}}}
{"_id":"71662a3a6b3a8294","name":"Linguistic Upload","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"linguistic-upload","actionType":{"value":"passive"},"actions":{"value":null},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot speaks two additional languages. Requires Artificial Personality or Sapient.</p><p>@Localize[SFMTP.CustomManualHint]</p><p><a href=\"https://2e.aonsrd.com/companions/types/robot/customizations\">Tech Core — Archives of Nethys</a></p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.robot-customizations.Item.71662a3a6b3a8294"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"linguistic-upload","customizationGrade":"commercial","automation":"manual"}}}
