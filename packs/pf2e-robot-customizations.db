{"_id":"73244eafcc76f082","name":"Aquatic Adaptation","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"aquatic-adaptation","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion gains a swim Speed of 20 feet. This customization adds that movement mode; it does not replace its other Speeds.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"BaseSpeed","selector":"swim","value":20}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.73244eafcc76f082"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"aquatic-adaptation","customizationGrade":"commercial","automation":"rules"}}}
{"_id":"b280797f59395ce8","name":"Armored Plates","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"armored-plates","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains a +1 item bonus to AC, or +2 if it is a superior robot companion. Use unarmored proficiency. Choose the appropriate bonus when adding this Item; update that choice if the companion advances.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ChoiceSet","flag":"armoredPlatesBonus","adjustName":false,"prompt":"SFMTP.CustomArmorPrompt","choices":[{"label":"SFMTP.CustomArmorNormal","value":1},{"label":"SFMTP.CustomArmorSuperior","value":2}]},{"key":"FlatModifier","selector":"ac","type":"item","value":"{item|flags.pf2e.rulesSelections.armoredPlatesBonus}","fromEquipment":false}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.b280797f59395ce8"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"armored-plates","customizationGrade":"commercial","automation":"rules"}}}
{"_id":"0131b13e97f3864c","name":"Artificial Personality","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"artificial-personality","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion gains an artificial personality. It can attempt skill checks that require Charisma and can speak Common.</p><p>@Localize[SFMTP.CustomManualHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.0131b13e97f3864c"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"artificial-personality","customizationGrade":"commercial","automation":"manual"}}}
{"_id":"5643c994f42b46e1","name":"Cameras","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"cameras","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Cameras built into the robot companion transmit its view to the owner. Using a comm unit or a similar device, you can see what the robot sees.</p><p>@Localize[SFMTP.CustomManualHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.5643c994f42b46e1"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"cameras","customizationGrade":"commercial","automation":"manual"}}}
