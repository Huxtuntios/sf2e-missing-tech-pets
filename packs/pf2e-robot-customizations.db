{"_id":"7df2af0f61909025","name":"High Speed","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"high-speed","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Increase one of the robot’s Speeds to 40 feet. Choose which Speed manually.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ChoiceSet","flag":"speed","adjustName":false,"prompt":"SFMTP.MovementTypePrompt","choices":[{"label":"PF2E.Actor.Speed.Type.Burrow","value":"burrow","predicate":["speed:burrow"]},{"label":"PF2E.Actor.Speed.Type.Climb","value":"climb","predicate":["speed:climb"]},{"label":"PF2E.Actor.Speed.Type.Fly","value":"fly","predicate":["speed:fly"]},{"label":"PF2E.Actor.Speed.Type.Land","value":"land","predicate":["speed:land"]},{"label":"PF2E.Actor.Speed.Type.Swim","value":"swim","predicate":["speed:swim"]}]},{"key":"BaseSpeed","selector":"{item|flags.pf2e.rulesSelections.speed}","value":40}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.7df2af0f61909025"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"high-speed","customizationGrade":"tactical","automation":"rules"}}}
{"_id":"03ed382696868239","name":"Network","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"network","actionType":{"value":"action"},"actions":{"value":1},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot has an integrated hacking kit. Connecting to an adjacent computer takes one action. While connected, the owner can attempt Computers checks as if adjacent to that computer.</p><p>@Localize[SFMTP.CustomManualHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.03ed382696868239"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"network","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"d8903991bcd09e59","name":"Share Charge","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"share-charge","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot can power battery-using items from its reserves, even if the item has no battery or charges.</p><p>@Localize[SFMTP.CustomManualHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.d8903991bcd09e59"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"share-charge","customizationGrade":"tactical","automation":"manual"}}}
{"_id":"3cddbcf49952f350","name":"Emergency Repair","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"emergency-repair","actionType":{"value":"action"},"actions":{"value":1},"frequency":{"max":1,"per":"PT10M"},"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Once per 10 minutes, spend one action to restore HP equal to the robot’s level, or twice its level if superior.</p><p>@Localize[SFMTP.CustomManualHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.3cddbcf49952f350"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"emergency-repair","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"49658a20b8d5b1db","name":"Maneuver Module","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"maneuver-module","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose two of Disarm, Grapple, Reposition, Shove or Trip. Gain a +1 circumstance bonus to those actions, or +2 if superior. Repeat selections must choose different actions.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ChoiceSet","flag":"maneuverOne","adjustName":false,"rollOption":"maneuver","prompt":"SFMTP.ManeuverModulePrompt","choices":[{"label":"SFMTP.ManeuverDisarm","value":"disarm"},{"label":"SFMTP.ManeuverGrapple","value":"grapple"},{"label":"SFMTP.ManeuverReposition","value":"reposition"},{"label":"SFMTP.ManeuverShove","value":"shove"},{"label":"SFMTP.ManeuverTrip","value":"trip"}]},{"key":"ChoiceSet","flag":"maneuverTwo","adjustName":false,"rollOption":"maneuver","prompt":"SFMTP.ManeuverModulePrompt","choices":[{"label":"SFMTP.ManeuverDisarm","value":"disarm","predicate":[{"not":"maneuver:disarm"}]},{"label":"SFMTP.ManeuverGrapple","value":"grapple","predicate":[{"not":"maneuver:grapple"}]},{"label":"SFMTP.ManeuverReposition","value":"reposition","predicate":[{"not":"maneuver:reposition"}]},{"label":"SFMTP.ManeuverShove","value":"shove","predicate":[{"not":"maneuver:shove"}]},{"label":"SFMTP.ManeuverTrip","value":"trip","predicate":[{"not":"maneuver:trip"}]}]},{"key":"ChoiceSet","flag":"maneuverBonus","adjustName":false,"prompt":"SFMTP.ManeuverBonusPrompt","choices":[{"label":"SFMTP.ManeuverBonusNormal","value":1},{"label":"SFMTP.ManeuverBonusSuperior","value":2}]},{"key":"FlatModifier","selector":"athletics","type":"circumstance","value":"{item|flags.pf2e.rulesSelections.maneuverBonus}","predicate":["action:{item|flags.pf2e.rulesSelections.maneuverOne}"]},{"key":"FlatModifier","selector":"athletics","type":"circumstance","value":"{item|flags.pf2e.rulesSelections.maneuverBonus}","predicate":["action:{item|flags.pf2e.rulesSelections.maneuverTwo}"]}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.49658a20b8d5b1db"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"maneuver-module","customizationGrade":"advanced","automation":"rules"}}}
{"_id":"1dba9ce0ddda8c56","name":"Optimized Avoidance","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"optimized-avoidance","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose a saving throw. A success on that save prevents damage, but not other effects. This customization can be selected more than once.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ChoiceSet","flag":"save","adjustName":false,"prompt":"SFMTP.SavePrompt","choices":[{"label":"PF2E.SavesFortitude","value":"fortitude"},{"label":"PF2E.SavesReflex","value":"reflex"},{"label":"PF2E.SavesWill","value":"will"}]},{"key":"Note","selector":"{item|flags.pf2e.rulesSelections.save}","outcome":["success","criticalSuccess"],"text":"{item|description}","title":"{item|name}"}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.1dba9ce0ddda8c56"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"optimized-avoidance","customizationGrade":"advanced","automation":"rules"}}}
{"_id":"656fcdfcbfd39f86","name":"Recharge","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"recharge","actionType":{"value":"action"},"actions":{"value":1},"frequency":null,"selfEffect":{"uuid":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.8a4adcb39a007962","name":"Effect: Recharge"},"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Spend one concentrate action to recharge a touched battery. The robot then becomes clumsy 1 for 1 round.</p><p>@Localize[SFMTP.CustomSelfEffectHint]</p>"},"traits":{"rarity":"common","value":["concentrate"],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.656fcdfcbfd39f86"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"recharge","customizationGrade":"advanced","automation":"rules"}}}
{"_id":"442bc16a6513e405","name":"Resistant Panels","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"resistant-panels","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose acid, bludgeoning, cold, fire, piercing, slashing or sonic. Gain resistance to that damage equal to half the robot’s level, rounded up. This customization can be selected more than once.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ChoiceSet","flag":"resistantPanels","adjustName":false,"prompt":"SFMTP.ResistantPanelsPrompt","choices":[{"label":"PF2E.TraitAcid","value":"acid"},{"label":"PF2E.TraitBludgeoning","value":"bludgeoning"},{"label":"PF2E.TraitCold","value":"cold"},{"label":"PF2E.TraitFire","value":"fire"},{"label":"PF2E.TraitPiercing","value":"piercing"},{"label":"PF2E.TraitSlashing","value":"slashing"},{"label":"PF2E.TraitSonic","value":"sonic"}]},{"key":"Resistance","type":["{item|flags.pf2e.rulesSelections.resistantPanels}"],"value":"(@actor.level + 1) / 2"}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.442bc16a6513e405"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"resistant-panels","customizationGrade":"advanced","automation":"rules"}}}
{"_id":"2447f193936e3c68","name":"Sapient","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"sapient","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion becomes sapient, but is not yet fully autonomous and does not gain a soul. It loses immunity to mental damage, its Intelligence modifier becomes +0, and it can attempt actions requiring Intelligence, Wisdom or Charisma. It can speak Common. In combat, the stress of battle means you must still Command it before it can act.</p><p>@Localize[SFMTP.CustomManualHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.2447f193936e3c68"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"sapient","customizationGrade":"advanced","automation":"manual"}}}
{"_id":"b793db50d6f0437c","name":"Agility Optimization","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"agility-optimization","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot’s movement does not trigger reactions. Acrobatics becomes expert, or master if already expert.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ActiveEffectLike","mode":"upgrade","path":"system.skills.acrobatics.rank","value":"min(3, max(2, @actor.system.skills.acrobatics.rank + 1))"}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.b793db50d6f0437c"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"agility-optimization","customizationGrade":"superior","automation":"rules"}}}
{"_id":"98cddaa4ac5bbd5b","name":"Camoflage","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"camoflage","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose a biome, such as plains or urban terrain. In that biome the robot companion can Sneak even while observed. Its Stealth proficiency becomes expert, or master if it was already expert.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ActiveEffectLike","mode":"upgrade","path":"system.skills.stealth.rank","value":"min(3, max(2, @actor.system.skills.stealth.rank + 1))"}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.98cddaa4ac5bbd5b"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"camoflage","customizationGrade":"superior","automation":"rules"}}}
{"_id":"0625f916d2cdde45","name":"Glow Up","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"glow-up","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>The robot companion becomes more expressive. Its Diplomacy proficiency becomes expert, or master if it was already expert, and its Charisma modifier becomes +3. Selecting this customization requires Artificial Personality or Sapient.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ActiveEffectLike","mode":"upgrade","path":"system.skills.diplomacy.rank","value":"min(3, max(2, @actor.system.skills.diplomacy.rank + 1))"},{"key":"ActiveEffectLike","mode":"override","path":"system.abilities.cha.mod","value":3}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.0625f916d2cdde45"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"glow-up","customizationGrade":"superior","automation":"rules"}}}
{"_id":"bb478ba107c9d171","name":"Speedster","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"speedster","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Your robot gains a +10-foot status bonus to all Speeds.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"FlatModifier","selector":"speed","type":"status","value":10}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.bb478ba107c9d171"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"speedster","customizationGrade":"superior","automation":"rules"}}}
