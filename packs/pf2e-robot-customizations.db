{"_id":"c17c99ae5a060683","name":"Integrated Weapon Mount","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"integrated-weapon-mount","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Gain one weapon mount per selection. Installing or removing a weapon takes 10 minutes and has the manipulate trait. One-handed weapons require one mount; two-handed weapons require two. A mounted weapon is wielded and cannot be Disarmed. Interact to reload it requires no hands and loses the manipulate trait.</p><p>@Localize[SFMTP.CustomManualHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.c17c99ae5a060683"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"integrated-weapon-mount","customizationGrade":"commercial","automation":"manual"}}}
{"_id":"014028713a67b53a","name":"Light Mounts","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"light-mounts","actionType":{"value":"action"},"actions":{"value":1},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":1,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Shed bright light within 20 feet and dim light for 20 feet beyond that. Switch the light on or off with one action.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"RollOption","option":"light-mounts","toggleable":true,"label":"SFMTP.LightMountsToggle"},{"key":"TokenLight","predicate":["light-mounts"],"value":{"bright":20,"dim":20}}]},"flags":{"core":{"sourceId":"Compendium.sf2e-missing-tech-pets.pf2e-robot-customizations.Item.014028713a67b53a"},"sf2e-missing-tech-pets":{"moduleProvided":true,"robotCustomization":true,"catalogId":"light-mounts","customizationGrade":"commercial","automation":"rules"}}}
