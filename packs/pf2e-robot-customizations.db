{"_id":"eb370f54d0561534","name":"Skill Module","type":"feat","img":"modules/sf2e-missing-tech-pets/assets/icons/powerful-chassis.svg","effects":[],"system":{"slug":"skill-module","actionType":{"value":"passive"},"actions":{"value":null},"frequency":null,"selfEffect":null,"category":"bonus","location":null,"level":{"value":1,"taken":1},"onlyLevel1":false,"maxTakable":null,"prerequisites":{"value":[]},"publication":{"title":"Tech Core","authors":"","license":"ORC","remaster":true},"description":{"value":"<p>Choose one skill in which the robot becomes trained. Repeat selections must choose different skills.</p><p>@Localize[SFMTP.CustomRulesHint]</p>"},"traits":{"rarity":"common","value":[],"otherTags":[]},"rules":[{"key":"ChoiceSet","flag":"skill","adjustName":false,"prompt":"SFMTP.SkillPrompt","choices":[{"label":"PF2E.Skill.Acrobatics","value":"acrobatics","predicate":["skill:acrobatics:rank:0"]},{"label":"PF2E.Skill.Arcana","value":"arcana","predicate":["skill:arcana:rank:0"]},{"label":"PF2E.Skill.Athletics","value":"athletics","predicate":["skill:athletics:rank:0"]},{"label":"PF2E.Skill.Crafting","value":"crafting","predicate":["skill:crafting:rank:0"]},{"label":"PF2E.Skill.Deception","value":"deception","predicate":["skill:deception:rank:0"]},{"label":"PF2E.Skill.Diplomacy","value":"diplomacy","predicate":["skill:diplomacy:rank:0"]},{"label":"PF2E.Skill.Intimidation","value":"intimidation","predicate":["skill:intimidation:rank:0"]},{"label":"PF2E.Skill.Medicine","value":"medicine","predicate":["skill:medicine:rank:0"]},{"label":"PF2E.Skill.Nature","value":"nature","predicate":["skill:nature:rank:0"]},{"label":"PF2E.Skill.Occultism","value":"occultism","predicate":["skill:occultism:rank:0"]},{"label":"PF2E.Skill.Performance","value":"performance","predicate":["skill:performance:rank:0"]},{"label":"PF2E.Skill.Religion","value":"religion","predicate":["skill:religion:rank:0"]},{"label":"PF2E.Skill.Society","value":"society","predicate":["skill:society:rank:0"]},{"la